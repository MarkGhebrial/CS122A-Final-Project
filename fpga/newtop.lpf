BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

// Set the clock to run at 25Mhz
LOCATE COMP "clk" SITE "P6";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 12.5 MHZ;

// Outputs to logic analyzer
LOCATE COMP "logic_analyzer_pins[0]" SITE "P7";
IOBUF PORT "logic_analyzer_pins[0]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[1]" SITE "R6";
IOBUF PORT "logic_analyzer_pins[1]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[2]" SITE "T4";
IOBUF PORT "logic_analyzer_pins[2]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[3]" SITE "T3";
IOBUF PORT "logic_analyzer_pins[3]" DRIVE=4 IO_TYPE=LVCMOS33;

LOCATE COMP "logic_analyzer_pins[4]" SITE "T6";
IOBUF PORT "logic_analyzer_pins[4]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[5]" SITE "R5";
IOBUF PORT "logic_analyzer_pins[5]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[6]" SITE "R4";
IOBUF PORT "logic_analyzer_pins[6]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "logic_analyzer_pins[7]" SITE "R3";
IOBUF PORT "logic_analyzer_pins[7]" DRIVE=4 IO_TYPE=LVCMOS33;


// Outputs for SD card communication
LOCATE COMP "sd_sck" SITE "J12";
IOBUF PORT "sd_sck" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "sd_pico" SITE "H12";
IOBUF PORT "sd_pico" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "sd_cs" SITE "G12";
IOBUF PORT "sd_cs" DRIVE=4 IO_TYPE=LVCMOS33;

// Inputs for SD card communication
LOCATE COMP "sd_poci" SITE "K12";
INPUT PORT "sd_poci" IO_TYPE=LVCMOS33;